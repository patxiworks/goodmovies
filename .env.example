# ---- Movies data source (your Apps Script JSON web app) ----
# Deploy Json.gs as a Web app and paste its /exec URL here.
MOVIES_JSON_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL of the deployed site (used for magic-link redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
